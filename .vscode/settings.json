{
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "[yaml]": {"editor.tabSize": 2},
  "[json]": {"editor.tabSize": 2},
  "[makefile]": {"editor.insertSpaces": false},
  "dbt.formatOnSave": true,
  "dbt.lintFixOnSave": false,
  "dbt.flag.defer": false,
  "search.exclude": {
    "**/.venv*/**": true,
    "**/target/**": true,
    "**/logs/**": true,
    "data/**": true,
    "baseline/**": true,
    "ci-output/**": true
  }
}
